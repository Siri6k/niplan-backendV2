# ==============================================================================
# Niplan Backend - Environment Variables Template (.env.example)
# Duplicate this file to .env and configure your local or production values.
# ==============================================================================

# --- Django Core ---
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://niplan_user:niplan_pass@localhost:5432/niplan_db

# --- Cache & Broker (Redis) ---
REDIS_URL=redis://127.0.0.1:6379/1

# --- Cloudinary (Media Storage) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Niplan <no-reply@niplan.com>

# --- Twilio / WhatsApp (Optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SMS_NUMBER=
TWILIO_ALPHA_SENDER_ID=Niplan
